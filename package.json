{
  "name": "@fahrizkyputra/pi-modes",
  "version": "0.4.0",
  "description": "Selectable, independent agent modes for Pi. /gercep: no tests/typecheck/lint/build, ends with a manual QA checklist. /hati-hati: confirm every risky command, ends with a rollback section. /auto-effort: a small judge model sets thinking to medium/high/xhigh per prompt. Default stays untouched.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "mode",
    "gercep",
    "fast",
    "qa",
    "checklist",
    "safety",
    "confirm",
    "rollback",
    "production",
    "effort",
    "thinking",
    "reasoning",
    "auto-effort"
  ],
  "license": "MIT",
  "author": "Fahrizky Putra",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fahrizkyputra/pi-modes.git"
  },
  "homepage": "https://github.com/fahrizkyputra/pi-modes#readme",
  "bugs": {
    "url": "https://github.com/fahrizkyputra/pi-modes/issues"
  },
  "type": "module",
  "pi": {
    "extensions": [
      "./extensions/pi-modes.ts"
    ]
  },
  "files": [
    "extensions",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "test:e2e": "node scripts/e2e-gercep.mjs && node scripts/e2e-careful.mjs && node scripts/e2e-effort.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "@earendil-works/pi-tui": "*"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
